---
---

<dialog id="ios-waitlist-modal" class="bg-surface border border-border text-text-main p-6 rounded-2xl shadow-2xl backdrop:bg-black/80 max-w-md w-full m-auto fixed inset-0 open:flex open:flex-col">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-xl font-bold">Únete a la lista de espera iOS</h3>
    <button id="close-modal" class="text-text-muted hover:text-text-main">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  
  <form id="waitlist-form" class="space-y-4" method="POST" action="https://assets.mailerlite.com/jsonp/1679408/forms/179203917310068240/subscribe">
    <div>
      <label for="email" class="block text-sm font-medium text-text-muted mb-1">Email</label>
      <input 
        type="email" 
        id="email" 
        name="fields[email]" 
        required 
        placeholder="tu@email.com"
        class="w-full bg-background border border-border rounded-lg px-4 py-2 text-text-main focus:outline-none focus:ring-2 focus:ring-primary"
      />
    </div>

    <!-- Hidden fields for MailerLite -->
    <input type="hidden" name="ml-submit" value="1">
    <input type="hidden" name="anticsrf" value="true">
    <!-- Consent Checkbox -->
    <div class="flex items-start gap-3 group">
      <div class="flex items-center h-5 mt-0.5">
        <input 
          id="marketing_consent" 
          type="checkbox" 
          required
          class="w-4 h-4 rounded border-border bg-background text-primary focus:ring-primary focus:ring-offset-surface cursor-pointer accent-primary"
        />
      </div>
      <label for="marketing_consent" class="text-xs text-text-muted group-hover:text-text-main transition-colors cursor-pointer select-none">
        Quiero recibir por email avisos del lanzamiento y actualizaciones de Caliber Guard. Puedo darme de baja en cualquier momento.
      </label>
    </div>

    <button 
      id="submit-btn"
      type="submit" 
      class="w-full bg-primary hover:bg-primary-hover text-black font-bold py-2 px-4 rounded-lg transition-colors flex justify-center items-center"
    >
      <span>Notificarme</span>
      <div id="loading-spinner" class="hidden ml-2 w-4 h-4 border-2 border-black/30 border-t-black rounded-full animate-spin"></div>
    </button>
    
    <!-- Legal Text (GDPR First Layer) -->
    <p class="text-[10px] text-text-muted leading-tight border-t border-border/50 pt-3 opacity-70">
      <span class="font-semibold">Responsable:</span> Antonio P. Madrazo Yáñez. 
      <span class="font-semibold">Finalidad:</span> gestionar la lista de espera y enviarte avisos. 
      <span class="font-semibold">Base:</span> tu consentimiento. 
      <span class="font-semibold">Derechos:</span> acceso, rectificación y supresión. 
      Más info en la <a href="/privacy" class="underline hover:text-text-main transition-colors">Política de Privacidad</a>.
    </p>
  </form>

  <div id="success-message" class="hidden mt-4 text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-900/30 text-green-400 mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <p class="text-green-400 font-medium">¡Gracias!</p>
    <p class="text-sm text-text-muted">Estás en la lista. Te avisaremos pronto.</p>
  </div>
  
  <div id="error-message" class="hidden mt-4 text-center">
    <p class="text-red-400 text-sm">Hubo un error al suscribirte. Por favor, inténtalo de nuevo.</p>
  </div>
</dialog>

<script>
  const modal = document.getElementById('ios-waitlist-modal');
  const closeBtn = document.getElementById('close-modal');
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-message');
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-btn');
  const loadingSpinner = document.getElementById('loading-spinner');
  const btnText = submitBtn?.querySelector('span');
  
  const openButtons = document.querySelectorAll('.js-open-ios-waitlist');

  openButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // @ts-ignore
      modal?.showModal();
      // Analytics
      // @ts-ignore
      if (typeof gtag !== 'undefined') {
        // @ts-ignore
        gtag('event', 'cta_ios_click');
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    // @ts-ignore
    modal?.close();
  });

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect()
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      // @ts-ignore
      modal.close()
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // UI Loading State
    if (submitBtn) submitBtn.setAttribute('disabled', 'true');
    if (loadingSpinner) loadingSpinner.classList.remove('hidden');
    if (btnText) btnText.textContent = 'Enviando...';
    if (errorMsg) errorMsg.classList.add('hidden');

    const formData = new FormData(form);
    // Add ajax flag to hopefully get JSON response, though MailerLite JSONP is tricky.
    // We will use standard form submission via fetch.
    formData.append('ajax', '1');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        mode: 'no-cors' // Important for MailerLite if not using JSONP script injection
      });
      
      // With mode: 'no-cors', we get an opaque response. We can't check .ok or status.
      // We assume success if no network error occurred. 
      // This is a trade-off for not using the heavy jQuery/Script injection.
      
      form.style.display = 'none';
      successMsg?.classList.remove('hidden');
      
      // Analytics
      // @ts-ignore
      if (typeof gtag !== 'undefined') {
        // @ts-ignore
        gtag('event', 'cta_ios_form_submit');
      }
      
      // Close after 2s
      setTimeout(() => {
        // @ts-ignore
        modal?.close();
        // Reset form for next time
        setTimeout(() => {
          form.reset();
          form.style.display = 'block';
          successMsg?.classList.add('hidden');
          if (submitBtn) submitBtn.removeAttribute('disabled');
          if (loadingSpinner) loadingSpinner.classList.add('hidden');
          if (btnText) btnText.textContent = 'Notificarme';
        }, 500);
      }, 3000);

    } catch (err) {
      console.error('Submission error:', err);
      // Reset UI
      if (submitBtn) submitBtn.removeAttribute('disabled');
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (btnText) btnText.textContent = 'Notificarme';
      if (errorMsg) errorMsg.classList.remove('hidden');
    }
  });
</script>
