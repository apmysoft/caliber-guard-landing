---
import { Image } from 'astro:assets';
import usageLogImg from '../assets/screens/usage-log.jpg';
import chronometryImg from '../assets/screens/chronometry.jpg';
import statisticsImg from '../assets/screens/statistics.jpg';
import { featureUrl } from '../content/features';

const features = [
  {
    title: "Control de uso",
    text: "Registra cada puesta y descubre qué relojes estás usando de verdad. Rankings, porcentajes y rotación en segundos.",
    notes: ["Gratis: registro de puestas", "Premium: informes y estadísticas de uso"],
    link: { href: featureUrl("registro-de-uso-de-relojes"), text: "Cómo funciona el registro de uso" },
    image: usageLogImg,
    alt: "Calendario de uso de Caliber Guard con el reloj que se llevó cada día del mes",
    align: "right"
  },
  {
    title: "Mantenimiento y cronometría",
    text: "Planifica revisiones, guarda notas y controla la marcha. Tu historial, siempre a mano.",
    notes: ["Gratis: cronometría básica", "Premium: mantenimiento con costes y alertas"],
    link: { href: featureUrl("cronometria-relojes-automaticos"), text: "Cómo medir la precisión de tu reloj" },
    image: chronometryImg,
    alt: "Cronometría de un Hamilton Murph en Caliber Guard: precisión media de -1,5 segundos al día y sus mediciones",
    align: "left"
  },
  {
    title: "Analítica económica",
    text: "Cuánto has invertido, cuánto has recuperado con las ventas y cuánto te cuesta cada puesta. Y los relojes que más usas, listos para compartir en redes.",
    notes: ["Premium: analítica avanzada y exportación"],
    link: { href: featureUrl("inventario-de-relojes"), text: "Inventario y exportación para el seguro" },
    image: statisticsImg,
    alt: "Analítica de Caliber Guard con inversión, ventas, balance neto y los diez relojes más usados",
    align: "right"
  }
];
---

<section class="py-20 lg:py-32 overflow-hidden">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-20">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">Qué puedes hacer</h2>
      <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
    </div>

    <div class="space-y-24 lg:space-y-32">
      {features.map((feature, index) => (
        <div class={`flex flex-col lg:flex-row items-center gap-12 lg:gap-20 ${feature.align === 'left' ? 'lg:flex-row-reverse' : ''}`}>
          
          <div class="flex-1 space-y-6">
            <h3 class="text-3xl lg:text-4xl font-bold">{feature.title}</h3>
            <p class="text-lg text-text-muted leading-relaxed text-balance">
              {feature.text}
            </p>
            <div class="flex flex-wrap gap-2">
              {feature.notes.map((note) => (
                <div class="inline-flex items-center px-3 py-1 bg-surface border border-border rounded-full text-xs font-mono text-primary">
                  {note}
                </div>
              ))}
            </div>
            <a href={feature.link.href} class="inline-flex items-center gap-2 text-primary hover:text-primary-hover font-bold transition-colors">
              {feature.link.text}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="flex-1 w-full flex justify-center perspective-1000 group">
             <!-- Card container with subtle 3D tilt effect on hover could go here, keeping it simple for now -->
             <div class="relative w-full max-w-[300px] bg-surface rounded-[2rem] border-4 border-border overflow-hidden transform transition-transform duration-500 hover:scale-[1.02]">
                <Image 
                  src={feature.image} 
                  alt={feature.alt}
                  class="w-full h-auto object-contain"
                  width={300}
                />
                <!-- Reflection/Glare -->
                <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent pointer-events-none"></div>
             </div>
          </div>
          
        </div>
      ))}
    </div>
  </div>
</section>
