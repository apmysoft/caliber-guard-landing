---
import { PLAY_URL, PREMIUM_PRICES, YEARLY_SAVING_PERCENT, formatEUR } from '../config';

// Planes según la versión 1.3 de la app. Mantener alineado con lo que
// bloquea la app (esPremium / tieneAnalitica en caliber-guard-flutter).
// La licencia vitalicia no se anuncia en la web.
const planBasico = [
  { titulo: 'Inventario ilimitado:', texto: 'Alta, edición y fotos.' },
  { titulo: 'Registro de uso:', texto: 'Calendario de puestas de cada reloj.' },
  { titulo: 'Cronometría básica:', texto: 'Mide la precisión.' },
  { titulo: 'Wishlist:', texto: 'Objetivos y enlaces.' },
  { titulo: 'Copia de seguridad mensual:', texto: 'Una al mes, con fotos, viendo anuncios. Restaurar siempre es gratis.' },
  { titulo: 'Prueba la analítica 24 h:', texto: 'Analítica avanzada y buscador gratis un día a la semana, viendo anuncios.' },
];

const planPremium = [
  { titulo: 'Todo lo del plan básico', texto: '' },
  { titulo: '100 % sin publicidad', texto: '' },
  { titulo: 'Analítica y buscador siempre activos:', texto: 'Dashboard financiero, ROI y balance.' },
  { titulo: 'Coste por puesta:', texto: 'Rentabilidad real de cada reloj.' },
  { titulo: 'Mantenimiento:', texto: 'Bitácora, costes y alertas.' },
  { titulo: 'Copias de seguridad ilimitadas:', texto: 'Cuando quieras, con fotos.' },
  { titulo: 'Importación y exportación:', texto: 'CSV para seguros e informes de uso en PDF.' },
];

const checkIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
---

<section id="planes" class="scroll-mt-16 py-20 lg:py-32 bg-surface/30 border-y border-border">
  <div class="container mx-auto px-4 max-w-5xl">

    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Planes</h2>
      <p class="text-text-muted text-lg">Empieza gratis y pasa a Premium solo si lo necesitas.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 items-stretch">

      <!-- Plan básico -->
      <div class="flex flex-col rounded-2xl bg-surface border border-border p-6 lg:p-8 border-t-4 border-t-green-500 shadow-xl">
        <h3 class="text-lg font-bold uppercase tracking-wide text-green-500">Plan Básico</h3>
        <p class="mt-4 mb-1"><strong class="text-4xl text-white">Gratis</strong></p>
        <p class="text-sm text-text-muted mb-6">Con anuncios y sin límite de relojes.</p>

        <ul class="space-y-4 pt-6 border-t border-white/5 mb-8">
          {planBasico.map((item) => (
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 shrink-0 text-green-500" set:html={checkIcon} />
              <div class="text-sm text-text-muted">
                <strong class="text-white block mb-0.5">{item.titulo}</strong>
                {item.texto}
              </div>
            </li>
          ))}
        </ul>

        <a
          href={PLAY_URL}
          data-position="plans_free"
          class="js-ga-android-link mt-auto w-full px-6 py-3 border border-green-500 text-green-500 hover:bg-green-500 hover:text-black font-bold rounded-full text-center transition-colors"
        >
          Descargar gratis
        </a>
      </div>

      <!-- Plan premium -->
      <div class="flex flex-col rounded-2xl bg-[#22201a] border border-primary/20 p-6 lg:p-8 border-t-4 border-t-primary shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none">
          <div class="w-32 h-32 bg-primary blur-[60px] rounded-full"></div>
        </div>

        <div class="relative z-10 flex flex-col h-full">
          <h3 class="text-lg font-bold uppercase tracking-wide text-primary">Plan Premium 💎</h3>
          <p class="mt-4 mb-1 text-text-muted">
            <strong class="text-4xl text-white">{formatEUR(PREMIUM_PRICES.monthly)}</strong>/mes
          </p>
          <p class="text-sm text-text-muted">
            o <strong class="text-white">{formatEUR(PREMIUM_PRICES.yearly)}/año</strong>
            <span class="ml-1 inline-block px-2 py-0.5 rounded-full bg-primary/15 text-primary text-xs font-bold">Ahorras un {YEARLY_SAVING_PERCENT} %</span>
          </p>
          <p class="text-xs text-text-muted mt-2 mb-6">IVA incluido. Cancela cuando quieras desde Google Play.</p>

          <ul class="space-y-4 pt-6 border-t border-primary/10 mb-8">
            {planPremium.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 shrink-0 text-primary" set:html={checkIcon} />
                <div class="text-sm text-text-muted">
                  <strong class="text-white block mb-0.5">{item.titulo}</strong>
                  {item.texto}
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-auto">
            <a
              href={PLAY_URL}
              data-position="plans_premium"
              class="js-ga-android-link block w-full px-6 py-3 bg-primary hover:bg-primary-hover text-black font-bold rounded-full text-center transition-colors shadow-[0_0_20px_rgba(212,175,55,0.2)]"
            >
              Descargar y activar Premium
            </a>
            <p class="text-xs text-text-muted text-center mt-3">Premium se activa desde Ajustes, dentro de la app.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
