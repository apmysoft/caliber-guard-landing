---
---

<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de cookies"
  class="fixed bottom-0 left-0 right-0 bg-neutral-900 border-t border-yellow-500/20 p-4 transform translate-y-full transition-transform duration-300 z-50 shadow-2xl"
  style="display: none;"
>
  <div class="container mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="text-neutral-300 text-sm flex-1">
      <p>
        Usamos cookies de Google Analytics para medir la audiencia, solo si las aceptas. Puedes cambiar tu elección cuando quieras desde «Configurar cookies», en el pie de la página.
        Más información en la <a href="/privacy/" class="text-yellow-400 hover:underline">política de privacidad</a>.
      </p>
    </div>
    <!-- Mismo tamaño y estilo para las dos opciones: rechazar es tan fácil como aceptar (AEPD). -->
    <div class="grid grid-cols-2 gap-3 shrink-0 w-full md:w-auto">
      <button id="cookie-reject" class="px-6 py-2 text-sm font-bold rounded border border-yellow-500 text-yellow-400 hover:bg-yellow-500 hover:text-black transition-colors">
        Rechazar
      </button>
      <button id="cookie-accept" class="px-6 py-2 text-sm font-bold rounded border border-yellow-500 text-yellow-400 hover:bg-yellow-500 hover:text-black transition-colors">
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function showBanner() {
    if (!banner) return;
    banner.style.display = 'block';
    // Small delay for animation
    setTimeout(() => banner.classList.remove('translate-y-full'), 50);
  }

  function hideBanner() {
    if (!banner) return;
    banner.classList.add('translate-y-full');
    setTimeout(() => { banner.style.display = 'none'; }, 300);
  }

  /** Borra las cookies de Google Analytics (_ga, _ga_XXXX, _gid) del dominio actual y del principal. */
  function deleteAnalyticsCookies() {
    const host = location.hostname;
    const domains = ['', host, `.${host}`, `.${host.split('.').slice(-2).join('.')}`];
    document.cookie.split(';').map((c) => c.split('=')[0].trim())
      .filter((name) => name.startsWith('_ga') || name === '_gid')
      .forEach((name) => {
        domains.forEach((domain) => {
          document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain ? `; domain=${domain}` : ''}`;
        });
      });
  }

  // Show banner if no consent stored
  if (!localStorage.getItem('cookie_consent')) showBanner();

  // «Configurar cookies» (pie) vuelve a mostrar el banner
  document.querySelectorAll('.js-open-cookie-settings').forEach((btn) => {
    btn.addEventListener('click', showBanner);
  });

  acceptBtn?.addEventListener('click', () => {
    const previous = localStorage.getItem('cookie_consent');
    localStorage.setItem('cookie_consent', 'granted');
    hideBanner();
    // Reload page to activate GA scripts (managed in Layout)
    if (previous !== 'granted') window.location.reload();
  });

  rejectBtn?.addEventListener('click', () => {
    const previous = localStorage.getItem('cookie_consent');
    localStorage.setItem('cookie_consent', 'denied');
    hideBanner();
    if (previous === 'granted') {
      // Retirada del consentimiento: borrar cookies y recargar para que GA deje de cargarse
      deleteAnalyticsCookies();
      window.location.reload();
    }
  });
</script>
