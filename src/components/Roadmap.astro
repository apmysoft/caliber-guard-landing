---
import changelogData from '../content/changelog.json';
import { HDR_THREAD_URL } from '../config';

// Según la hoja de ruta de la app (R-64, R-19, R-23, R-21).
const proximamente = [
  { titulo: 'Copia en Google Drive:', texto: 'Tu colección a salvo fuera del móvil.' },
  { titulo: 'Cronometría por posiciones:', texto: 'Mediciones por posición y por sesión.' },
  { titulo: 'Facturas y garantías:', texto: 'Adjunta el PDF o la foto a cada reloj.' },
  { titulo: 'Idiomas y monedas:', texto: 'La app en más idiomas y con tu moneda.' },
];
---

<section id="hoja-de-ruta" class="scroll-mt-16 py-20 lg:py-32">
  <div class="container mx-auto px-4 max-w-6xl">

    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Hoja de ruta y novedades</h2>
      <p class="text-text-muted text-lg">Lo que viene y lo que ya ha llegado a la app.</p>
    </div>

    <!-- Próximamente -->
    <div class="max-w-3xl mx-auto mb-20 rounded-2xl bg-surface border-dashed border border-cyan-400/30 p-6 lg:p-8 border-t-4 border-t-cyan-400 shadow-xl">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/5">
        <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.6)]"></div>
        <h3 class="text-lg font-bold uppercase tracking-wide text-cyan-400">Próximamente 🚀</h3>
      </div>
      <ul class="grid sm:grid-cols-2 gap-5">
        {proximamente.map((item) => (
          <li class="flex items-start gap-3">
            <div class="w-5 h-5 flex items-center justify-center shrink-0 text-cyan-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <div class="text-sm text-text-muted">
              <strong class="text-white block mb-0.5">{item.titulo}</strong>
              {item.texto}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Changelog -->
    <div class="max-w-3xl mx-auto border-t border-border pt-16">
      <h3 class="text-xl font-bold mb-2 text-text-muted uppercase tracking-widest text-sm">Registro de cambios</h3>
      <p class="text-sm text-text-muted mb-8">
        ¿Echas algo en falta?
        <a href={HDR_THREAD_URL} target="_blank" rel="noopener" data-position="changelog" class="js-ga-forum-link text-primary hover:text-primary-hover underline underline-offset-4">Propónlo en el hilo del foro</a>.
      </p>
      <div class="space-y-8 relative before:absolute before:left-[7px] before:top-10 before:bottom-0 before:w-[2px] before:bg-border">
        {[...changelogData].reverse().map((log) => (
          <div class="relative pl-8">
            <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-border border-2 border-text-muted"></div>
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 mb-1">
              <span class="text-lg font-bold text-text-main">{log.version}</span>
              <span class="text-sm font-mono text-text-muted">{log.date}</span>
            </div>
            <p class="text-text-muted text-sm">{log.description}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
