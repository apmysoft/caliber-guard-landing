<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-white/5 transition-all duration-300">
  <div class="container mx-auto px-4 h-16 flex items-center">
    <!-- Logo with specific mobile/desktop sizing (28px/32px height) -->
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80 group py-2">
      <img 
        src="/app_icon.png" 
        alt="Caliber Guard Logo" 
        class="h-7 w-auto md:h-8 object-contain" 
        width="32"
        height="32"
      />
      <!-- Optional text with reduced opacity and small size -->
      <span class="text-xs md:text-sm font-medium tracking-wide text-white/40 group-hover:text-white/70 transition-colors uppercase">
        Caliber Guard
      </span>
    </a>
  </div>
</header>
