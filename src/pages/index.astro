---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import Features from '../components/Features.astro';
import MiniCTA from '../components/MiniCTA.astro';
import Story from '../components/Story.astro';
import Privacy from '../components/Privacy.astro';
import Roadmap from '../components/Roadmap.astro';
import Articles from '../components/Articles.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import Faq from '../components/Faq.astro';
import Plans from '../components/Plans.astro';
import { faq } from '../content/faq';
import { SITE_URL, PLAY_URL, PREMIUM_PRICES } from '../config';

const description =
  'Registra qué reloj llevas cada día, controla mantenimiento y marcha y conoce el valor de tu colección. Gratis en Android, sin cuentas y con tus datos en tu móvil.';

const orgId = `${SITE_URL}#organization`;
const premiumOffer = (name: string, price: string, duration: string, unitCode: string) => ({
  '@type': 'Offer',
  name,
  price,
  priceCurrency: 'EUR',
  url: PLAY_URL,
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price,
    priceCurrency: 'EUR',
    valueAddedTaxIncluded: true,
    billingDuration: duration,
    unitCode,
  },
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Caliber Guard',
      url: SITE_URL,
      logo: new URL('/apple-touch-icon.png', SITE_URL).href,
      email: 'contacto@caliberguard.com',
      sameAs: [
        'https://www.instagram.com/caliberguard/',
        'https://www.youtube.com/@CaliberGuard',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      url: SITE_URL,
      name: 'Caliber Guard',
      inLanguage: 'es-ES',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'MobileApplication',
      '@id': `${SITE_URL}#app`,
      name: 'Caliber Guard',
      description,
      operatingSystem: 'ANDROID',
      applicationCategory: 'LifestyleApplication',
      inLanguage: 'es',
      url: SITE_URL,
      installUrl: PLAY_URL,
      image: new URL('/og-image.jpg', SITE_URL).href,
      publisher: { '@id': orgId },
      offers: [
        { '@type': 'Offer', name: 'Plan Básico', price: '0', priceCurrency: 'EUR', url: PLAY_URL },
        premiumOffer('Premium mensual', PREMIUM_PRICES.monthly, 'P1M', 'MON'),
        premiumOffer('Premium anual', PREMIUM_PRICES.yearly, 'P1Y', 'ANN'),
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE_URL}#faq`,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<Layout
  title="App para gestionar tu colección de relojes | Caliber Guard"
  description={description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <Header />
	<main class="overflow-x-hidden">
		<Hero />
		<Audience />
		<Features />
		<MiniCTA />
		<Story />
		<Privacy />
		<Plans />
		<Faq />
		<Roadmap />
		<Articles />
	</main>
	<Footer />
  <WaitlistModal />
</Layout>
