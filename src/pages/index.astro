---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import Features from '../components/Features.astro';
import MiniCTA from '../components/MiniCTA.astro';
import Story from '../components/Story.astro';
import Privacy from '../components/Privacy.astro';
import Roadmap from '../components/Roadmap.astro';
import Articles from '../components/Articles.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
---

<Layout
  title="App para gestionar tu colección de relojes | Caliber Guard"
  description="Registra qué reloj llevas cada día, controla mantenimiento y marcha y conoce el valor de tu colección. Gratis en Android, sin cuentas y con tus datos en tu móvil."
>
    <Header />
	<main class="overflow-x-hidden">
		<Hero />
		<Audience />
		<Features />
		<MiniCTA />
		<Story />
		<Privacy />
		<Roadmap />
		<Articles />
	</main>
	<Footer />
  <WaitlistModal />
</Layout>
