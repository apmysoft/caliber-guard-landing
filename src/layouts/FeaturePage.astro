---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import { SITE_URL, playUrl } from '../config';
import { featurePages, featureUrl, type FeatureSlug } from '../content/features';

interface Props {
  slug: FeatureSlug;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { slug, title, description, eyebrow, heading, intro, image, imageAlt } = Astro.props;
const others = featurePages.filter((page) => page.slug !== slug);
const current = featurePages.find((page) => page.slug === slug)!;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Caliber Guard', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: current.label, item: new URL(featureUrl(slug), SITE_URL).href },
  ],
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <Header />
  <main class="overflow-x-hidden pt-24 lg:pt-32">

    <section class="container mx-auto px-4 max-w-6xl pb-16 lg:pb-24">
      <nav aria-label="Ruta" class="text-sm text-text-muted mb-8">
        <a href="/" class="hover:text-text-main transition-colors">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-text-main">{current.label}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="space-y-6">
          <span class="text-primary font-bold uppercase tracking-widest text-sm block">{eyebrow}</span>
          <h1 class="text-4xl lg:text-5xl font-bold leading-tight text-balance">{heading}</h1>
          <p class="text-lg lg:text-xl text-text-muted text-balance">{intro}</p>
          <a
            href={playUrl(`feature_${slug}`)}
            data-position={`feature_${slug}`}
            class="js-ga-android-link inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-hover text-black font-bold rounded-full transition-colors shadow-[0_0_20px_rgba(212,175,55,0.2)]"
          >
            Probar gratis en Android
          </a>
        </div>
        <div class="flex justify-center">
          <div class="w-full max-w-[280px] lg:max-w-[320px] bg-surface rounded-[2rem] border-4 border-border overflow-hidden shadow-2xl">
            <Image src={image} alt={imageAlt} class="w-full h-auto" width={320} loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <article class="bg-surface/30 border-y border-border py-16 lg:py-24">
      <div class="container mx-auto px-4 max-w-3xl feature-prose">
        <slot />
      </div>
    </article>

    <section class="container mx-auto px-4 max-w-3xl py-16 lg:py-24 text-center space-y-6">
      <h2 class="text-2xl lg:text-3xl font-bold">Pruébala con tu colección</h2>
      <p class="text-text-muted text-lg">Gratis, sin crear cuenta y con tus datos guardados en tu móvil.</p>
      <a
        href={playUrl(`feature_${slug}_bottom`)}
        data-position={`feature_${slug}_bottom`}
        class="js-ga-android-link inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-hover text-black font-bold rounded-full transition-colors"
      >
        Descargar en Google Play
      </a>
      <p class="text-sm text-text-muted pt-6">
        Más funciones:
        {others.map((page, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={featureUrl(page.slug)} class="text-text-main hover:text-primary underline underline-offset-4">{page.label}</a>
          </>
        ))}
        <span aria-hidden="true"> · </span>
        <a href="/#planes" class="text-text-main hover:text-primary underline underline-offset-4">Planes y precios</a>
      </p>
    </section>

  </main>
  <Footer />
  <WaitlistModal />
</Layout>

<style is:global>
  .feature-prose h2 { font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: var(--color-text-main); margin: 2.5rem 0 1rem; }
  .feature-prose h2:first-child { margin-top: 0; }
  .feature-prose p, .feature-prose li { color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.75; }
  .feature-prose p { margin-bottom: 1rem; }
  .feature-prose ul, .feature-prose ol { margin: 0 0 1rem 1.25rem; }
  .feature-prose ul { list-style: disc; }
  .feature-prose ol { list-style: decimal; }
  .feature-prose li { margin-bottom: 0.5rem; }
  .feature-prose strong { color: var(--color-text-main); }
  .feature-prose a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 1024px) { .feature-prose h2 { font-size: 1.875rem; line-height: 2.25rem; } }
</style>
