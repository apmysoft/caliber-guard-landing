---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro'; // Import component
import '@fontsource/inter';
import '@fontsource/roboto-mono';

interface Props {
	title: string;
	description: string;
	/** Ruta pública de la imagen para compartir (1200×630). */
	image?: string;
	imageAlt?: string;
}

const {
	title,
	description,
	image = '/og-image.jpg',
	imageAlt = 'Caliber Guard: app para gestionar tu colección de relojes',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const GA_ID = 'G-QCZXVWE90J';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Caliber Guard" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="mTQVrfNF49g_yFTQypq3lv7HPPx8DPXNdbLGQhRuaxA" />

    <!-- GA4 Check & Inject -->
    <script is:inline define:vars={{ GA_ID }}>
      const userConsent = localStorage.getItem('cookie_consent');
      if (userConsent === 'granted') {
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
      }
    </script>
	</head>
	<body class="antialiased selection:bg-primary selection:text-black">
		<slot />
    <CookieConsent />
    
    <script>
      // Global Analytics Event Listeners
      document.addEventListener('DOMContentLoaded', () => {
        // Track Android Download Clicks
        const androidButtons = document.querySelectorAll('.js-ga-android-link');
        androidButtons.forEach(btn => {
          btn.addEventListener('click', () => {
             // @ts-ignore
            if (typeof gtag !== 'undefined') {
               // @ts-ignore
              gtag('event', 'click_download_android', {
                'event_category': 'engagement',
                'event_label': 'hero_android_download'
              });
            }
          });
        });

      });
    </script>
	</body>
</html>
