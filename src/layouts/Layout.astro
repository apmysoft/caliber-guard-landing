---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro'; // Import component
import '@fontsource/inter';
import '@fontsource/roboto-mono';

interface Props {
	title: string;
}

const { title } = Astro.props;
const GA_ID = 'G-QCZXVWE90J';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Lleva el control total de tu colección de relojes. Estadísticas de uso diario, mantenimiento y valor económico." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

    <!-- GA4 Check & Inject -->
    <script is:inline define:vars={{ GA_ID }}>
      const userConsent = localStorage.getItem('cookie_consent');
      if (userConsent === 'granted') {
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
      }
    </script>
	</head>
	<body class="antialiased selection:bg-primary selection:text-black">
		<slot />
    <CookieConsent />
    
    <script>
      // Global Analytics Event Listeners
      document.addEventListener('DOMContentLoaded', () => {
        // Track Android Download Clicks
        const androidButtons = document.querySelectorAll('.js-ga-android-link');
        androidButtons.forEach(btn => {
          btn.addEventListener('click', () => {
             // @ts-ignore
            if (typeof gtag !== 'undefined') {
               // @ts-ignore
              gtag('event', 'click_download_android', {
                'event_category': 'engagement',
                'event_label': 'hero_android_download'
              });
            }
          });
        });
      });
    </script>
</html>
